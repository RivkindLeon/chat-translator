{
  "name": "openclaw-plugin-chat-translator",
  "version": "1.1.0",
  "type": "module",
  "main": "index.js",
  "description": "OpenClaw plugin. Translate WhatsApp group chats into a language you actually read and forward them to Telegram or a webhook — text, voice messages and photos.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RivkindLeon/chat-translator.git"
  },
  "files": [
    "index.js",
    "src",
    "tools",
    "openclaw.plugin.json",
    "README.md",
    "DOC.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.0"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.0"
    },
    "build": {
      "openclawVersion": "2026.9.4"
    }
  }
}
